# ─────────────────────────────────────────────────────────────────────────────
# Trading Dashboard — Server Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Variables marked [REQUIRED] must be set before the server will work.
# Variables marked [OPTIONAL] have sensible defaults and can be omitted.
# ─────────────────────────────────────────────────────────────────────────────


# ── Zerodha Kite API ──────────────────────────────────────────────────────────

# [REQUIRED] Your Kite Connect app credentials.
# Create an app at https://developers.kite.trade/ and copy the values here.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# [OPTIONAL] Initial access token.
# The dashboard refreshes this automatically after each login via the
# "Connect Kite" button.  You can leave this blank on first start.
KITE_ACCESS_TOKEN=

# [OPTIONAL] Redirect URL for the Kite OAuth callback.
# Set this to your deployed client URL in production.
# Must match the redirect URL configured in your Kite app settings.
# Default: http://localhost:5173
FRONTEND_URL=https://your-app.vercel.app


# ── Telegram ──────────────────────────────────────────────────────────────────

# [OPTIONAL] Telegram Bot Token — get this from @BotFather on Telegram.
# Required only if you want Telegram scan alerts and order notifications.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [OPTIONAL] Numeric Telegram chat ID where alerts will be sent.
# Get your chat ID from @userinfobot after messaging your bot.
# Can also be set via the Settings panel in the dashboard.
TELEGRAM_CHAT_ID=123456789

# [OPTIONAL] Set to true to disable Telegram long-polling on this instance.
# Use this in local development when Railway is also running simultaneously —
# only one instance can hold the Telegram long-poll connection at a time.
# Default: false (polling runs normally)
DISABLE_TELEGRAM_POLLING=false


# ── Security ──────────────────────────────────────────────────────────────────

# [OPTIONAL] Shared secret checked on every API request via the x-api-key header.
# The client must set VITE_API_SECRET to the same value.
# If left blank, the auth middleware is disabled (fine for local dev).
API_SECRET=

# [OPTIONAL] Used by the /api/kite/auth/* routes as an admin password
# to protect the Kite re-login flow from being triggered by anyone.
# Leave blank to skip the check (local dev only — always set in prod).
OWNER_SECRET=


# ── MongoDB — Pattern Analytics ───────────────────────────────────────────────
#
# MongoDB is OPTIONAL.  If MONGODB_URI is not set, the server runs normally
# and simply skips all database writes.  No errors are thrown — the Analytics
# page will show a "MongoDB not connected" notice instead of data.
#
# When connected, the server persists:
#   • scan_alerts  — every pattern match from manual, background, and live scans
#   • paper_trades — every paper trade open/close with pattern context
#
# These two collections power the Analytics tab's frequency, win-rate, and
# daily P&L tables.  No candle data is stored (Kite ToS prohibits redistribution).

# [OPTIONAL] MongoDB Atlas connection string (or any MongoDB-compatible URI).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI=

# [OPTIONAL] Database name inside the MongoDB cluster.
# Default: twp  (Trading With Purpose)
MONGODB_DB=twp


# ── Data Persistence ──────────────────────────────────────────────────────────
#
# Paper trades and daily archives are stored as JSON files on disk.
# In local development these land in server/data/.
# On Railway, mount a persistent Volume at /data and set DATA_DIR=/data so
# files survive redeployments.

# [OPTIONAL] Absolute path to the directory where runtime data files are stored.
# Files written here:
#   trades-current.json         — open paper trades (write-through on every change)
#   history/trades-YYYY-MM-DD.json — daily archive files created at 06:00 IST
# Default: <server_root>/data/
DATA_DIR=/data


# ── Server ────────────────────────────────────────────────────────────────────

# [OPTIONAL] HTTP port the Express server listens on.
# Railway sets this automatically; you only need it for local dev if 3001 is taken.
# Default: 3001
PORT=3001

#liveOrderEnabled = true in config of server to placing live trades
