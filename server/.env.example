# Zerodha Kite API Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access token is managed via the dashboard (refreshed daily via Login button)
# You can also set it here for initial setup, but it will be overridden after login
KITE_ACCESS_TOKEN=

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Server Port (optional)
PORT=3001
