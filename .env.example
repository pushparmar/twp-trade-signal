# ── Kite / Zerodha ────────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=         # set automatically after daily login; leave blank

# ── Owner re-auth protection ───────────────────────────────────────────────────
# Random secret to protect /api/kite/auth/owner-refresh
OWNER_SECRET=change_this_to_a_random_string

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/trading

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
